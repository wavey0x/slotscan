# SlotScan Environment Configuration
# Copy this to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql+asyncpg://wavey@localhost:5432/slotscan_dev

# =============================================================================
# RPC ENDPOINTS (must support debug_traceTransaction for tx diff features)
# =============================================================================
# Ethereum Mainnet
RPC_URL_1=http://192.168.1.102:8545

# Sepolia Testnet (optional)
# RPC_URL_11155111=http://your-sepolia-node:8545

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================
# Etherscan API key (for fetching verified source code)
# Get yours at: https://etherscan.io/apis
ETHERSCAN_API_KEY_1=your_mainnet_etherscan_key

# Sepolia Etherscan (optional, same key usually works)
# ETHERSCAN_API_KEY_11155111=your_sepolia_etherscan_key

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# API Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# CACHE SETTINGS
# =============================================================================
# TTL in minutes (0 = no expiry)
CACHE_SNAPSHOT_TTL_MINUTES=30
CACHE_TX_DIFF_TTL_MINUTES=0
TRANSACTION_RESPONSE_CACHE_BYTES=67108864
TERMINAL_RESPONSE_CACHE_TTL_SECONDS=60

# =============================================================================
# LIMITS
# =============================================================================
MAX_SLOTS_PER_CONTRACT=10000
MAX_SSTORE_OPS=10000
REQUEST_TIMEOUT_SECONDS=15
MAX_PARALLEL_CONTRACT_RESOLUTIONS=8
CONTRACT_RESOLUTION_TIMEOUT_SECONDS=6
